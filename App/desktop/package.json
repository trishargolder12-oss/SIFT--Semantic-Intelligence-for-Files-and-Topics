{
  "name": "sift-local-library",
  "version": "0.3.3",
  "private": true,
  "description": "SIFT offline library and conversational file discovery",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && npm run build:electron && electron .",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test:ui": "node tests/ui-smoke.cjs",
    "test:previews": "node tests/preview-smoke.cjs",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "build:service": "node scripts/build-service.cjs",
    "dist": "npm run build && npm run build:service && electron-builder && npm run build:updater",
    "test:discovery": "node tests/discovery-smoke.cjs",
    "build:updater": "node scripts/build-updater.cjs",
    "test:updater": "node scripts/test-updater.cjs",
    "build:ocr-pack": "node scripts/build-ocr-pack.cjs",
    "test:shortcuts": "npm run build:electron && node tests/shortcuts-smoke.cjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^9.2.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "org.sift.local-library",
    "productName": "SIFT",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/sift-indexer.exe",
        "to": "service/sift-indexer.exe"
      }
    ],
    "directories": {
      "output": "release/${version}"
    },
    "win": {
      "icon": "build/sift.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
